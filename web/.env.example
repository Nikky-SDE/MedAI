# ==============================================================================
# MedAI - Medical Triage & Clinical Mapping Environment Variables
# Copy this file to .env.local and configure with your credentials.
# ==============================================================================

# --- Supabase PostgreSQL Database & Auth (Required) ---
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- AI Inference Engines ---
# Primary AI: Groq Cloud API Key (Get at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional Groq Model ID (Defaults to openai/gpt-oss-120b if omitted)
GROQ_MODEL_ID=openai/gpt-oss-120b

# Fallback AI: Google Gemini API Key (Get at https://aistudio.google.com)
# Used when Groq fails, encounters rate limits, or for multimodal vision inference
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Gemini Model ID (Defaults to gemini-2.5-flash if omitted)
GEMINI_MODEL_ID=gemini-2.5-flash

# --- Safety & Rate Limiting (Optional) ---
# Maximum AI triage turns per user per hour (Defaults to 30)
MAX_TRIAGE_CALLS_PER_HOUR=30
# Maximum final reports created per user per day (Defaults to 10)
MAX_REPORTS_PER_DAY=10

# --- Interactive Geocoding & Mapping ---
# MapTiler API Key (Optional, get at https://cloud.maptiler.com)
# If omitted or empty, MedAI automatically falls back to open MapLibre demo tiles.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Offline Testing & CI (Optional) ---
# Set to 'true' to run E2E tests and CI without external AI API credits.
# Strictly disabled in production.
MOCK_LLM=false
