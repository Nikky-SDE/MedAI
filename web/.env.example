# ==============================================================================
# MedAI - Clinical AI Symptom Triage Environment Variables
# Copy this file to .env.local and configure with your credentials.
# ==============================================================================

# --- Supabase PostgreSQL Database & Auth (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- AI Inference Engines ---
# Primary AI: Groq Cloud API Key (Get at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional Groq Model ID (Defaults to openai/gpt-oss-120b if omitted)
GROQ_MODEL_ID=openai/gpt-oss-120b

# Fallback AI: Google Gemini API Key (Get at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Interactive Geocoding & Mapping ---
# MapTiler API Key (Get at https://cloud.maptiler.com)
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
